{
  "name": "shanyu-coffee-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "serve:dist": "node scripts/serve-dist.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:prod": "E2E_MODE=production playwright test",
    "test:report": "playwright show-report artifacts/e2e-development/html",
    "verify": "npm run typecheck && npm run test:unit && npm run test:e2e && npm run build && npm run test:e2e:prod"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
